{
  "name": "holstrom-strategy",
  "version": "1.0.0",
  "description": "Holstrom CLMM strategy testing with Surfpool",
  "main": "dist/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "test": "node dist/tests/holstromTest.js",
    "test:ts": "ts-node tests/holstromTest.ts",
    "run:strategy": "ts-node src/runHolstromSimple.ts",
    "run:real": "ts-node src/runHolstromReal.ts",
    "run:actual": "ts-node src/runHolstromActual.ts",
    "run:tx": "ts-node src/runHolstromRealTx.ts",
    "run:fully-real": "ts-node src/runHolstromFullyReal.ts",
    "run:real-swaps": "ts-node src/runHolstromRealSwaps.ts",
    "run:final-real": "ts-node src/runHolstromFinalReal.ts",
    "run:holstrom-real": "ts-node src/runHolstromRealStrategy.ts",
    "run:atomic": "ts-node src/runHolstromAtomic.ts",
    "run:no-buyback": "ts-node src/runHolstromNoBuyback.ts",
    "test:meteora": "ts-node src/testMeteoraIntegration.ts",
    "test:orca": "ts-node src/testOrcaIntegration.ts",
    "test:flashloan": "ts-node src/testFlashLoanIntegration.ts",
    "test:integrated": "ts-node src/testIntegratedSDK.ts",
    "test:raydium": "ts-node src/testRaydiumIntegration.ts",
    "rust:test": "cargo test",
    "rust:run": "cargo run"
  },
  "keywords": [
    "solana",
    "surfpool",
    "clmm",
    "defi",
    "strategy"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@jup-ag/lend": "^0.2.0",
    "@orca-so/common-sdk": "^0.7.1",
    "@orca-so/whirlpools-sdk": "^0.22.0",
    "@project-serum/anchor": "^0.26.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.60-alpha",
    "@solana/spl-memo": "^0.2.5",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@solana/surfpool": "^1.5.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
